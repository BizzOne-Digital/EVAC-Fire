# Public site URL (no trailing slash). Used for canonical URLs, sitemap, robots and Open Graph.
# The production domain is not confirmed yet; set this at deploy time.
NEXT_PUBLIC_SITE_URL=

# Endpoint that receives contact-form leads as a JSON POST (Zapier, Make, HubSpot, CRM or email relay).
# Required in production: without it the form reports an error instead of pretending to send.
LEAD_WEBHOOK_URL=

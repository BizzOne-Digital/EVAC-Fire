# MongoDB Atlas connection string (Atlas > Connect > Drivers). Required.
# In Atlas > Network Access, allow Vercel to connect (0.0.0.0/0, or Vercel's static IPs on paid plans).
MONGODB_URI=
# Database name inside the cluster (default: evac).
MONGODB_DB=evac

# First admin account, created by `npm run seed` if it does not exist yet. Use a strong password (12+ characters).
# After the first seed you can remove ADMIN_PASSWORD; change the password under Admin > Admin Account.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Public site URL (no trailing slash). Used for canonical URLs, sitemap, robots and Open Graph.
NEXT_PUBLIC_SITE_URL=

# Optional: also forward each new inquiry as a JSON POST (Zapier, Make, HubSpot, CRM or email relay).
# Inquiries are always saved to the database and shown in Admin > Inquiries.
LEAD_WEBHOOK_URL=
